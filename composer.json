{
  "name": "hans-peter-ording/fantasypros-api-client",
  "type": "library",
  "description": "Client library to consume the FantasyPros public API (NFL) and transform results into data transfer objects.",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "symfony/serializer": "^6.0|^7.0|^8.0",
    "symfony/property-access": "^6.0|^7.0|^8.0",
    "psr/http-client": "^1.0",
    "php-http/discovery": "^1.9",
    "php-http/logger-plugin": "^1.2",
    "symfony/property-info": "^6.0|^7.0|^8.0",
    "phpdocumentor/reflection-docblock": "^5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "symfony/http-client": "^7.0|^8.0",
    "nyholm/psr7": "^1.8"
  },
  "suggest": {
    "symfony/http-client": "PSR-18 client and PSR-17 factories in one package, usable via Psr18Client",
    "guzzlehttp/guzzle": "Popular PSR-18 HTTP client implementation",
    "nyholm/psr7": "Lightweight PSR-17 request/URI factory implementation, commonly paired with Guzzle"
  },
  "autoload": {
    "psr-4": {
      "HansPeterOrding\\FantasyProsApiClient\\": "src/"
    },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "HansPeterOrding\\FantasyProsApiClient\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
